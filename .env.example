# ZPath MVP environment variables

SUPABASE_URL=

# Server-only. Do not expose this to frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used to sign ZPath username/password auth cookies.
# Use a random value with at least 32 characters.
AUTH_JWT_SECRET=

# Server-only. Vertex AI Gemini uses Application Default Credentials.
# Local dev may use the provided gen-lang-client-*.json file, which is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
PROMPT_VERSION=zpath-career-eval-v1

# Public Tally form id used by the survey page.
NEXT_PUBLIC_TALLY_FORM_ID=

# Server-only. Web search provider for the advisor.
# Options: gemini_grounding | tavily | serper | none
# If not set, auto-detects based on available credentials.
WEB_SEARCH_PROVIDER=

# Server-only. API keys for web search providers (if not using gemini_grounding).
# TAVILY_API_KEY=
# SERPER_API_KEY=

# Server-only. Set to "true" ONLY for dev/testing to force mock advisor answers.
# In production, leave unset or set to "false" — the real AI pipeline will be used.
# ADVISOR_USE_MOCK=false

# Do not expose server-only env vars to frontend.
