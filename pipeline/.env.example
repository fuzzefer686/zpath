# ============================================================================
# Pipeline configuration — copy this file to `.env` and fill in real values.
# Do NOT commit the real `.env` file (it contains secrets).
# ============================================================================

# ---- Google Cloud / Vertex AI ----------------------------------------------

# Your GCP project ID (e.g. gen-lang-client-0447269763).
GCP_PROJECT_ID=

# Vertex AI location. "global" is valid for the google-genai SDK and is
# recommended for Google Search Grounding. Regional values (e.g. us-central1,
# asia-southeast1) also work — switch here if grounding is unavailable.
GCP_REGION=global

# Gemini model ID. Confirmed GA as of June 2026: gemini-3.1-flash-lite.
# (gemini-2.0-* was shut down 2026-06-01.) test_connection.py will fall back
# to GEMINI_MODEL_FALLBACK if this model errors.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite

# --- Service account authentication (choose ONE of the two below) ---
# Option A: path to the service account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Option B: the same key, base64-encoded into a single line (no file on disk).
# If set, this takes precedence over GOOGLE_APPLICATION_CREDENTIALS.
# GOOGLE_APPLICATION_CREDENTIALS_BASE64=

# ---- Supabase --------------------------------------------------------------

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key (server-side only — full DB access, keep secret).
SUPABASE_SERVICE_ROLE_KEY=
